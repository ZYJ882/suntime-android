<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding_h"
        android:paddingEnd="@dimen/page_padding_h"
        android:paddingTop="@dimen/page_padding_top"
        android:paddingBottom="@dimen/space_16">

        <!-- ============ 指南盘（上提，消除下方空白）============ -->
        <com.example.suntime.view.CompassView
            android:id="@+id/compassView"
            android:layout_width="@dimen/compass_size"
            android:layout_height="@dimen/compass_size"
            android:layout_marginTop="@dimen/space_8" />

        <!-- ============ 核心读数 ============ -->
        <TextView
            android:id="@+id/tvHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:includeFontPadding="false"
            android:text="0°"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_reading"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <TextView
            android:id="@+id/tvHeadingDir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="北 N"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_sm" />

        <!-- ============ 分隔 ============ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_24"
            android:background="@color/divider" />

        <!-- ============ 当前位置（紧跟读数，不再沉底）============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="当前位置"
            style="@style/Text.Suntime.Section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="纬度"
                    style="@style/Text.Suntime.Sub" />

                <TextView
                    android:id="@+id/tvLat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:fontFamily="sans-serif-medium"
                    android:text="--"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_value" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="经度"
                    style="@style/Text.Suntime.Sub" />

                <TextView
                    android:id="@+id/tvLng"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:fontFamily="sans-serif-medium"
                    android:text="--"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_value" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnLocate"
            style="@style/Widget.Suntime.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_16"
            android:text="获取当前位置" />

        <TextView
            android:id="@+id/tvAccuracy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:minLines="2"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_sm"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/tvAddressSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />

    </LinearLayout>
</ScrollView>
