<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding_h"
        android:paddingEnd="@dimen/page_padding_h"
        android:paddingTop="@dimen/page_padding_top"
        android:paddingBottom="@dimen/space_16"
        android:maxWidth="@dimen/content_max_width"
        android:layout_gravity="center_horizontal">

        <!-- 返回栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.Suntime.Button.Icon"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_previous"
                app:tint="@color/text_secondary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_4"
                android:text="@string/stopwatch_title"
                style="@style/Text.Suntime.Header" />
        </LinearLayout>

        <!-- 计时大数字（含百分秒，用 reading 字阶避免溢出） -->
        <TextView
            android:id="@+id/tvStopwatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:gravity="center"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:text="00:00:00.00"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_reading" />

        <!-- 操作 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartPause"
                style="@style/Widget.Suntime.Button"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="@string/stopwatch_start" />

            <Button
                android:id="@+id/btnReset"
                style="@style/Widget.Suntime.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_8"
                android:text="@string/stopwatch_reset" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center"
            android:text="@string/stopwatch_hint"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_body_sm" />

    </LinearLayout>
</ScrollView>
